# Copy to .env and fill in before running docker compose up.

# DeepSeek API key - used for ad detection over the transcript.
# Any OpenAI-compatible endpoint works; change the base URL in
# Settings -> Ad Detection after first boot.
DEEPSEEK_API_KEY=

# Host port for the Audiobookshelf web UI
ABS_PORT=13378

# CPU cores the transcription sidecar may use.
# Budget roughly 3x realtime on an AVX-only Xeon: a 1 hour episode
# takes about 20 minutes of wall clock at 3 cores.
WHISPER_THREADS=3

TZ=America/New_York
